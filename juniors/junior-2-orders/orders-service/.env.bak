# ============================================================
# FlashDrop - Orders Service - Environment Variables Example
# Copy this file to .env and fill in the values
# ============================================================

# --- Database (Supabase/PostgreSQL) ---
DATABASE_URL=jdbc:postgresql://localhost:5432/flashdrop
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=Passsupagessof1!

# --- RabbitMQ ---
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/

# --- Business ---
# Delivery fee in CLP (Chilean Pesos)
DELIVERY_FEE=2500
