# FlashDrop - Orders Service - Environment (LOCAL DEV)
# =====================================================
# Copy to .env and fill in the real values:
#     cp .env.example .env
# WARNING: Never commit the .env file (it is gitignored).
#
# These Supabase credentials are EXCLUSIVE to Orders.
# orders-service owns ONLY: client, orders, order_items.
# Other services (Auth/Catalog/Delivery) manage their own databases.
# In production/stack these come from the host variables
# ORDERS_SUPABASE_URL / ORDERS_SUPABASE_SERVICE_ROLE_KEY (see gateway/docker).

SPRING_PROFILES_ACTIVE=supabase

# --- Orders' OWN Supabase project (provisional, independent) ---
# Base URL of the Orders Supabase Kong/PostgREST endpoint (/rest/v1).
# Use a placeholder locally; provide the real value in production only.
SUPABASE_URL=https://YOUR-ORDERS-PROJECT.supabase.co
# Service Role Key of the Orders Supabase project (PostgREST auth). NEVER commit a real key.
SUPABASE_SERVICE_ROLE_KEY=PLACEHOLDER_SERVICE_ROLE_KEY

DELIVERY_FEE=2500

AUTH_SERVICE_URL=http://localhost:8081
CATALOG_SERVICE_URL=http://localhost:8082
DELIVERY_SERVICE_URL=http://localhost:8084
INTERNAL_API_KEY=dev-key

RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
