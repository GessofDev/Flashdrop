# =====================================================================
# FlashDrop Backend — Variables de entorno compartidas
# =====================================================================
# Este archivo es la FUENTE DE VERDAD para los valores que todos los
# microservicios y el gateway necesitan. NO commitear con valores
# reales; usar este .template para que cada dev copie y complete.
#
# Cómo usarlo en Coolify:
#   1. En cada servicio (gateway, auth, catalog, orders, delivery),
#      ir a "Environment Variables" en Coolify.
#   2. Copiar cada variable de este archivo con su valor real.
#   3. Los valores sensibles (POSTGRES_PASSWORD, INTERNAL_API_KEY) se
#      generan UNA vez y se mantienen; no rotarlos sin coordinar.
#
# Cómo generar valores nuevos:
#   openssl rand -hex 32          # para INTERNAL_API_KEY
#   openssl rand -base64 24       # para passwords de servicios
# =====================================================================

# ---------------------------------------------------------------------
# RED INTERNA DE COOLIFY
# ---------------------------------------------------------------------
# Los nombres de host son los nombres de los recursos en Coolify.
# Coolify los resuelve vía DNS interno (no hace falta IP).
# ---------------------------------------------------------------------

POSTGRES_HOST=flashdrop-postgres
POSTGRES_PORT=5432

REDIS_HOST=flashdrop-redis
REDIS_PORT=6379

# ---------------------------------------------------------------------
# POSTGRES — Credenciales del superusuario (admin)
# ---------------------------------------------------------------------
# Las genera Coolify al crear el recurso. Guardarlas en un password
# manager; este usuario solo se usa para tareas administrativas
# (migraciones, backups, debugging).
# ---------------------------------------------------------------------

POSTGRES_USER=postgres
POSTGRES_PASSWORD=REEMPLAZAR_CON_OUTPUT_DE_COOLIFY

# ---------------------------------------------------------------------
# REDIS — URL completa para el gateway
# ---------------------------------------------------------------------
# El gateway usa ioredis; esta URL la lee desde REDIS_URL con
# interpolación en docker/gateway.yaml.
# ---------------------------------------------------------------------

REDIS_URL=redis://flashdrop-redis:6379

# ---------------------------------------------------------------------
# SEGURIDAD INTER-SERVICIO
# ---------------------------------------------------------------------
# INTERNAL_API_KEY es el header X-Internal-Api-Key que el plan de
# migración menciona (sección 10) para proteger los endpoints
# /api/internal/* entre microservicios. DEBE ser el mismo valor en
# los 4 servicios y en el gateway.
#
# Generar con: openssl rand -hex 32
#
# AUTH_SERVICE_JWKS_URI / AUTH_SERVICE_ISSUER son consumidos por
# delivery-service (y eventualmente otros servicios que validen JWT
# localmente) para verificar tokens RS256 emitidos por auth-service.
# La ruta NO es la RFC 7517 estándar: el endpoint real es
# /auth/.well-known/jwks.json (verificado en JwksController.java:26).
# ---------------------------------------------------------------------

INTERNAL_API_KEY=REEMPLAZAR_CON_OPENSSL_RAND_HEX_32
AUTH_SERVICE_JWKS_URI=http://flashdrop-auth:8081/auth/.well-known/jwks.json
AUTH_SERVICE_ISSUER=flashdrop-auth

# ---------------------------------------------------------------------
# PUERTOS POR SERVICIO (asignación del plan de migración, sección 14)
# ---------------------------------------------------------------------
# Servicio          Puerto  Responsable
# Auth              8081    Nicolás
# Catalog           8082    Javier
# Orders            8083    Felipe
# Delivery          8084    Sebastián
# Gateway           3000    (este proyecto)
# ---------------------------------------------------------------------

AUTH_SERVICE_PORT=8081
CATALOG_SERVICE_PORT=8082
ORDERS_SERVICE_PORT=8083
DELIVERY_SERVICE_PORT=8084
GATEWAY_PORT=3000

# ---------------------------------------------------------------------
# URLs INTERNAS entre servicios
# ---------------------------------------------------------------------
# El gateway y los microservicios se llaman entre sí por nombre de
# recurso de Coolify (resolución DNS interna). NO usar localhost.
# ---------------------------------------------------------------------

AUTH_SERVICE_URL=http://flashdrop-auth:8081
CATALOG_SERVICE_URL=http://flashdrop-catalog:8082
ORDERS_SERVICE_URL=http://flashdrop-orders:8083
# delivery-service usa ORDERS_SERVICE_URL para su HttpOrderServiceClientAdapter (comunica
# con orders-service por HTTP en vez de Supabase REST). En el futuro, usar AWS Parameter
# Store o service discovery en lugar de esta variable fija.
DELIVERY_SERVICE_URL=http://flashdrop-delivery:8084
GATEWAY_URL=http://flashdrop-gateway:3000

# ---------------------------------------------------------------------
# CONFIGURACIÓN DEL GATEWAY
# ---------------------------------------------------------------------
# Estas variables las lee docker/Dockerfile del gateway; el YAML
# efectivo vive en gateway/docker/gateway.yaml.

GATEWAY_CONFIG_PATH=/app/config/gateway.yaml
GATEWAY_LOG_LEVEL=info

# ---------------------------------------------------------------------
# CREDENCIALES POR SERVICIO (las generadas en 01-postgres-init.sql)
# ---------------------------------------------------------------------
# Cada servicio se conecta a su BD con su propio usuario. Reemplazar
# con los valores reales cuando se haya ejecutado el init script.

AUTH_DB_NAME=auth_db
AUTH_DB_USER=auth_svc
AUTH_DB_PASSWORD=REEMPLAZAR_CON_AUTH_SVC_PASS

CATALOG_DB_NAME=catalog_db
CATALOG_DB_USER=catalog_svc
CATALOG_DB_PASSWORD=REEMPLAZAR_CON_CATALOG_SVC_PASS

ORDERS_DB_NAME=orders_db
ORDERS_DB_USER=orders_svc
ORDERS_DB_PASSWORD=REEMPLAZAR_CON_ORDERS_SVC_PASS

DELIVERY_DB_NAME=delivery_db
DELIVERY_DB_USER=delivery_svc
DELIVERY_DB_PASSWORD=REEMPLAZAR_CON_DELIVERY_SVC_PASS
# Delivery-service connects to its dedicated DB. Defaults use the shared Postgres host.
DELIVERY_DB_HOST=${POSTGRES_HOST}
DELIVERY_DB_PORT=${POSTGRES_PORT}
# For delivery-service: set SPRING_PROFILES_ACTIVE=delivery so the JPA/Flyway
# configuration (application-delivery.yml) activates. The "delivery" profile
# configures the dedicated DataSource against delivery_db (delivery_svc user).

# ---------------------------------------------------------------------
# AMBIENTE
# ---------------------------------------------------------------------
# NODE_ENV=production para el gateway en container (omite stack traces
# en respuestas de error). development solo para debug local.

NODE_ENV=production
SPRING_PROFILES_ACTIVE=production
