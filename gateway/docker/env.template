# ============================================
# FlashDrop Stack — Secrets template
# ============================================
# 1. Copiá este archivo como .env:
#      cp gateway/docker/env.template gateway/docker/.env
# 2. Reemplazá SUPABASE_SERVICE_ROLE_KEY con la key real.
# 3. .env está en .gitignore. NO commitear el .env real.

# --- Shared Supabase project (Auth / Catalog / Delivery) ---
# URL del proyecto Supabase compartido por Auth/Catalog/Delivery
SUPABASE_URL=http://supabasekong-wymwq8rktid7ov678oe4va90.76.13.169.150.sslip.io

# Service Role Key del proyecto compartido (Dashboard > Settings > API > service_role)
# (NO la anon key — esa es solo para clientes con RLS)
SUPABASE_SERVICE_ROLE_KEY=<tu-service-role-key-real-aqui>

# --- Orders' OWN Supabase project (provisional, independent) ---
# Cada servicio administra su propia BD. Orders ya NO comparte este proyecto.
# Estas variables se inyectan en orders-service como SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY.
# URL del proyecto Supabase EXCLUSIVO de Orders (Kong/PostgREST, /rest/v1)
ORDERS_SUPABASE_URL=https://YOUR-ORDERS-PROJECT.supabase.co
# Service Role Key del proyecto Supabase EXCLUSIVO de Orders
ORDERS_SUPABASE_SERVICE_ROLE_KEY=<tu-orders-service-role-key-real-aqui>