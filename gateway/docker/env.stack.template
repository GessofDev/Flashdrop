# =============================================================================
# Plantilla para el `.env` de docker-compose.stack.yml
# =============================================================================
#   cp env.stack.template .env      # y completar
#
# El `.env` esta en .gitignore. Este repositorio es PUBLICO: ningun valor real
# entra en un archivo versionado.
#
# Las contraseñas de base no se piden por chat. Cada duenio de servicio las
# guarda en Secrets Manager y en el gestor del equipo; en Floci no se pueden
# recuperar desde la UI una vez creada la instancia.
# =============================================================================

# --- Contraseñas de base, una por servicio ----------------------------------
# Usuarios y puertos ya estan fijos en el compose:
#   auth      auth_app     172.16.1.2:7004  flashdrop_auth
#   catalog   catalog_app  172.16.1.2:7001  flashdrop_catalog
#   orders    orders_app   172.16.1.2:7002  flashdrop_orders
#   delivery  (pendiente)  172.16.1.2:7005  delivery_db
AUTH_DB_PASSWORD=
CATALOG_DB_PASSWORD=
ORDERS_DB_PASSWORD=
# delivery_svc todavia puede no existir en la instancia de Floci: la creo
# `adminfloci` y el usuario por servicio lo define
# infra/coolify/01-postgres-init.sql, que se escribio para Coolify. Hay que
# crearlo ahi antes de levantar el stack.
DELIVERY_DB_PASSWORD=

# --- Clave compartida entre los cinco servicios ------------------------------
# Se genera UNA vez y es la misma en todos:
#   openssl rand -hex 32
# Si cada uno genera la suya, todas las llamadas entre servicios dan 403.
INTERNAL_API_KEY=

# --- Par RSA para firmar los JWT ---------------------------------------------
#   openssl genrsa -out jwt-private.pem 2048
#   openssl rsa -in jwt-private.pem -pubout -out jwt-public.pem
#
# El valor va en UNA SOLA LINEA y SIN saltos, no con barra-ene literales.
# RsaKeyProvider.decodePem quita los marcadores BEGIN/END y todo el espacio en
# blanco antes de decodificar base64: un salto real desaparece, pero una barra
# seguida de ene no es espacio en blanco, queda dentro del base64 y lo rompe.
# Hay que sacar los saltos, no escaparlos:
#   tr -d '[:space:]' < jwt-private.pem
#
# Si las claves ya estan en Secrets Manager se leen directo, sin pasar por
# archivos sueltos en disco:
#   aws --endpoint-url http://127.0.0.1:4566 secretsmanager get-secret-value \
#     --secret-id auth/jwt-private-key --query SecretString --output text | tr -d '[:space:]'
#
# NO reutilizar el par que esta versionado en gateway/docker/secrets/: esa
# clave privada quedo publicada y hay que darla por comprometida.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# --- PENDIENTES de respuesta -------------------------------------------------

# Felipe. Ver el comentario GAP-06 en el application.properties de orders:
# `true` si flashdrop_orders es una base propia y nueva; `false` si es una
# instancia ya existente sin flyway_schema_history.
ORDERS_FLYWAY_ENABLED=

# RESUELTO por Sebastian: el perfil es `delivery` a secas y el usuario es
# `delivery_svc`. Ambos quedaron fijos en el compose, no hace falta ponerlos
# aca. Ver la nota de abajo sobre crear el usuario en Floci.

# --- Opcionales --------------------------------------------------------------
# RabbitMQ: no hace falta broker. Orders publica eventos pero nadie los
# consume todavia (no hay ningun @RabbitListener en el repositorio). Cuando se
# implemente el consumidor, agregar el contenedor al compose.

# Origenes permitidos por CORS en catalog.
# CORS_ALLOWED_ORIGINS=http://localhost:3000

# Delegacion del claim de delivery hacia orders. Por defecto false.
# DELIVERY_CLAIM_DELEGATE=false
