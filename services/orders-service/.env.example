# FlashDrop - Orders Service - Environment (LOCAL DEV)
# =====================================================
# Copy to .env and fill in the real values:
#     cp .env.example .env
# WARNING: Never commit the .env file (it is gitignored).
#
# orders-service owns ONLY: client, orders, order_items.
# Other services (Auth/Catalog/Delivery) manage their own databases.
#
# GAP-01 (audit 2026-09-04): this file used to default to
# SPRING_PROFILES_ACTIVE=supabase, which silently ran orders-service against
# the pre-migration Supabase-REST adapters (SupabaseRestClientAdapter /
# SupabaseRestOrderRepositoryAdapter) instead of the migrated architecture
# (JPA + Orders' own PostgreSQL database, per MIGRATION_PLAN.md §1/§6).
# "postgres" is now the explicit, unambiguous default here, matching both
# application.properties' own fallback (spring.profiles.active=${SPRING_PROFILES_ACTIVE:postgres})
# and the real local stack launcher (start-flashdrop-e2e.bat).

SPRING_PROFILES_ACTIVE=postgres

# --- Orders' OWN PostgreSQL database (independent from Auth/Catalog/Delivery) ---
# Local example values only — never put real credentials here.
DB_URL=jdbc:postgresql://localhost:5433/flashdrop_orders
DB_USERNAME=orders_app
DB_PASSWORD=orders_app_pass

# Flyway applies db/migration/V1__init.sql on startup against the URL above.
# Only set FLYWAY_ENABLED=false if you are pointing DB_URL at a database that
# was NOT created fresh by Flyway (e.g. a shared/pre-provisioned instance
# without a baselined flyway_schema_history) — see GAP-06 in the audit report.
# FLYWAY_ENABLED=false

DELIVERY_FEE=2500

AUTH_SERVICE_URL=http://localhost:8081
CATALOG_SERVICE_URL=http://localhost:8082
DELIVERY_SERVICE_URL=http://localhost:8084
INTERNAL_API_KEY=dev-key

RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest

# --- Legacy/transition profile (Supabase REST) — NOT used by default ---
# Only needed if you explicitly set SPRING_PROFILES_ACTIVE=supabase to run
# against the old SupabaseRestClientAdapter/SupabaseRestOrderRepositoryAdapter
# path (application-supabase.properties). Kept for the transition window
# documented in MIGRATION_PLAN.md; do not use for the migrated architecture.
# SUPABASE_URL=https://YOUR-ORDERS-PROJECT.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=PLACEHOLDER_SERVICE_ROLE_KEY
