# =========================================================================
# CONFIGURACIÓN PARA DESARROLLO LOCAL (Plantilla)
# Copia este archivo a `.env` y configura tus valores.
# =========================================================================

# -------------------------------------------------------------------------
# 1. Base de datos
# -------------------------------------------------------------------------
# Las variables de conexion estan en el bloque 4a. El bloque que habia aca,
# heredado del .env.example del monorepo, definia DB_URL apuntando a un
# docker-compose local y chocaba con la configuracion real del servicio.

# -------------------------------------------------------------------------
# 2. Seguridad y JWT (Auth Service)
# -------------------------------------------------------------------------
# En desarrollo (local), auth-service generará un par de claves efímeras 
# en cada reinicio si no se proveen estas claves. 
# Para probar el catalog-service protegido con JWT, debes copiar aquí la 
# CLAVE PÚBLICA que el auth-service escupe en sus logs al iniciar, o bien 
# generar tu propio par de claves RSA (PEM) y pegarlas abajo.

# Ejemplo de clave pública (reemplaza con la tuya):
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nMIIBIjANBgkqhkiG9w0BAQEFAAOCAQ8AMIIBCgKCAQEA...\n-----END PUBLIC KEY-----"

# -------------------------------------------------------------------------
# 3. Puertos Locales
# -------------------------------------------------------------------------
AUTH_SERVICE_PORT=8081
CATALOG_SERVICE_PORT=8082
API_GATEWAY_PORT=8080

# -------------------------------------------------------------------------
# 4. Base de datos propia en Floci RDS
# -------------------------------------------------------------------------
# El puerto lo asigna Floci al crear la instancia: hay que leerlo de la UI,
# no asumirlo. Desde un contenedor en la red floci_default el host es `floci`;
# si el servicio corre directo en Ubuntu, es 127.0.0.1.
#
# El esquema y los datos de desarrollo los crea Flyway al arrancar
# (db/migration/V1 y V2). No hay que ejecutar SQL a mano.
DB_URL=jdbc:postgresql://floci:PUERTO/flashdrop_auth
DB_USERNAME=auth_app
DB_PASSWORD=

