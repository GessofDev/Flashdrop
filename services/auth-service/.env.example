# =========================================================================
# auth-service — plantilla de configuración local
# Copiar a `.env` y completar. El `.env` está en .gitignore.
# =========================================================================

# -------------------------------------------------------------------------
# 1. Base de datos propia (Floci RDS)
# -------------------------------------------------------------------------
# auth-service es dueño de sus cinco tablas y no comparte base con nadie.
# Ninguna de las tres tiene valor por defecto en la aplicación: si falta una,
# el servicio no arranca en vez de caer contra una base equivocada.
#
# El puerto lo asigna Floci al crear la instancia y puede cambiar si alguien
# la recrea. Hay que leerlo, no asumirlo:
#   aws --endpoint-url http://127.0.0.1:4566 rds describe-db-instances \
#     --query 'DBInstances[].{id:DBInstanceIdentifier,port:Endpoint.Port}' --output table
#
# Desde un contenedor en la red floci_default el host es `floci`; si el
# servicio corre directo sobre Ubuntu, es 127.0.0.1.
DB_URL=jdbc:postgresql://floci:7004/flashdrop_auth
DB_USERNAME=auth_app
DB_PASSWORD=

# -------------------------------------------------------------------------
# 2. Migraciones y datos de desarrollo
# -------------------------------------------------------------------------
# Flyway crea el esquema al arrancar. El seed vive aparte en db/seed y solo se
# aplica si se pide, para que ningún entorno productivo termine con usuarios
# demo de credenciales conocidas.
#
# Las bases de desarrollo ya tienen la V2 aplicada, así que necesitan esta
# variable aunque no quieran recargar nada. Contra una base productiva: dejar
# únicamente `classpath:db/migration`.
FLYWAY_LOCATIONS=classpath:db/migration,classpath:db/seed

# -------------------------------------------------------------------------
# 3. Clave compartida entre microservicios
# -------------------------------------------------------------------------
# Protege `/api/internal/**`. Es la misma en los cinco servicios y se genera
# una sola vez con `openssl rand -hex 32`. Sin ella el filtro responde 403 a
# todo: falla cerrado a propósito.
INTERNAL_API_KEY=

# -------------------------------------------------------------------------
# 4. Claves JWT (RS256)
# -------------------------------------------------------------------------
# `JWT_ALLOW_EPHEMERAL` viene en `false`: sin claves, el servicio NO arranca.
# Es deliberado. Con más de una réplica y clave efímera, cada instancia
# firmaría con una clave distinta y el JWKS de una no validaría los tokens de
# la otra: los logins fallarían de forma intermitente según a qué instancia
# caiga cada request.
#
# `run-auth.sh` lo pone en `true` para pruebas locales de una sola instancia.
# Para cualquier otra cosa, generar el par:
#   openssl genrsa -out private.pem 2048
#   openssl rsa -in private.pem -pubout -out public.pem
#
# El valor va en UNA SOLA LINEA y SIN saltos. `RsaKeyProvider.decodePem` quita
# los marcadores BEGIN/END y todo el espacio en blanco antes de decodificar
# base64, asi que un `
` literal --barra y ene-- corrompe la clave: no es
# espacio en blanco y no se elimina. Hay que sacar los saltos, no escaparlos:
#   tr -d '
' < private.pem
JWT_ALLOW_EPHEMERAL=false
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# Opcionales, con valores por defecto razonables en application.yml.
# JWT_ACCESS_MIN=15
# JWT_REFRESH_DAYS=30

# -------------------------------------------------------------------------
# 5. Puerto
# -------------------------------------------------------------------------
PORT=8081
