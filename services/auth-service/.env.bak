# auth-service — variables de entorno para Supabase

# ---- JWT (RS256, firma asimétrica) ----
# Dev sin claves: permitir clave efímera generada al arranque
JWT_ALLOW_EPHEMERAL=true
JWT_ACCESS_MIN=15
JWT_REFRESH_DAYS=30

# ---- Rate limiting de login ----
AUTH_RL_MAX=5
AUTH_RL_WINDOW=300

