SPRING_PROFILES_ACTIVE=postgres

# Floci/PostgreSQL Catalog database
DB_URL=jdbc:postgresql://127.0.0.1:7001/flashdrop_catalog
DB_USERNAME=catalog_app
DB_PASSWORD=tu_password
INTERNAL_API_KEY=una-clave-interna-segura
CATALOG_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:4200
AUTH_SERVICE_JWKS_URI=http://auth-service:8081/auth/.well-known/jwks.json
AUTH_SERVICE_ISSUER=flashdrop-auth

# Product images. FloCI is reachable as http://floci:4566 from stack containers.
S3_ENDPOINT=http://localhost:4566
S3_BUCKET=flashdrop-products
S3_REGION=us-east-1
S3_ACCESS_KEY=test
S3_SECRET_KEY=test
S3_PUBLIC_URL_BASE=/catalog/images

# Legacy/Supabase profile, kept only as transition fallback
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=tu_service_role_key

# Old postgres variables kept for compatibility with previous local setups
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=tu_password
POSTGRES_SSLMODE=disable
